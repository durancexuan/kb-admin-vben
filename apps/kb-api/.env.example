PORT=8080
DATABASE_URL=postgresql://kb:kb_secret@127.0.0.1:5432/kb
ACCESS_TOKEN_SECRET=access_token_secret
DEFAULT_STATION_ID=default
EMBEDDING_DIM=512
EMBEDDING_MODEL=local-hash-v1

# 本地 BGE 语义向量（推荐：先启动 scripts/bge-embedding-server.py）
# pip install -r requirements-bge.txt
# python scripts/bge-embedding-server.py
EMBEDDING_API_URL=http://127.0.0.1:8090/embed
EMBEDDING_API_FORMAT=simple
EMBEDDING_API_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_API_TIMEOUT_MS=60000

# 未配置 EMBEDDING_API_URL 时回退 local-hash-v1（仅开发联调，无语义能力）

ROBOT_API_KEY=robot-dev-key
MIN_RETRIEVE_SCORE=0.35
