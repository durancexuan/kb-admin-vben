# 端口号
VITE_PORT=5555

VITE_BASE=/

# 接口地址（/api 经 Vite 代理；问答见 vite.config 中 kb-api）
VITE_GLOB_API_URL=/api

# 知识库/机器人后端（三库 + /api/robot）；直连负责人服务器，无需本地 pnpm dev:kb-api
VITE_KB_API_TARGET=http://192.168.13.7:8089

# Mock：登录等仍走本地 Nitro Mock
VITE_NITRO_MOCK=true

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 钉钉登录配置
VITE_GLOB_AUTH_DINGDING_CLIENT_ID=应用的clientId
VITE_GLOB_AUTH_DINGDING_CORP_ID=应用的corpId
