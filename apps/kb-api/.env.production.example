# 复制为 .env 后用于 docker compose -f docker-compose.prod.yml
# cp .env.production.example .env

# 数据库（与 compose 中 postgres 服务一致）
POSTGRES_PASSWORD=请改成强密码

# 对外端口（宿主机）
KB_API_PORT=8089

# kb-api 运行时（compose 会覆盖 DATABASE_URL 指向 postgres 容器）
ROBOT_API_KEY=请改成随机长密钥
ACCESS_TOKEN_SECRET=请改成随机长字符串
DEFAULT_STATION_ID=default
MIN_RETRIEVE_SCORE=0.35

# 向量维度（须与 pgvector 表 vector(N) 一致，默认 384）
EMBEDDING_DIM=384
EMBEDDING_MODEL=local-hash-v1

# 负责人 GPU Embedding 服务（生产强烈建议配置）
# EMBEDDING_API_URL=http://<GPU内网IP>:8080/v1/embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_API_MODEL=bge-small-zh-v1.5
# EMBEDDING_API_FORMAT=openai
# EMBEDDING_API_TIMEOUT_MS=30000
