PORT=8080
DATABASE_URL=postgresql://kb:kb_secret@127.0.0.1:5432/kb
ACCESS_TOKEN_SECRET=access_token_secret
DEFAULT_STATION_ID=default
EMBEDDING_DIM=384
EMBEDDING_MODEL=local-hash-v1

# 外部 Embedding API（负责人 GPU 服务，配置后自动启用真实语义向量）
# 仅填 URL 即可；内网无鉴权时可省略 EMBEDDING_API_KEY
# EMBEDDING_API_URL=http://192.168.1.100:8080/v1/embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_API_MODEL=bge-small-zh-v1.5
# EMBEDDING_API_FORMAT=openai
# EMBEDDING_API_TIMEOUT_MS=30000

# OpenAI 兼容示例
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_API_MODEL=text-embedding-3-small

# HuggingFace TEI 原生接口示例（非 OpenAI 路径）
# EMBEDDING_API_URL=http://192.168.1.100:8080/embed
# EMBEDDING_API_FORMAT=tei
# EMBEDDING_API_MODEL=bge-small-zh-v1.5

# Ollama 示例
# EMBEDDING_API_URL=http://192.168.1.100:11434/api/embeddings
# EMBEDDING_API_FORMAT=ollama
# EMBEDDING_API_MODEL=bge-m3

ROBOT_API_KEY=robot-dev-key
MIN_RETRIEVE_SCORE=0.35
