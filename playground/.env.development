# 端口号
VITE_PORT=5555

VITE_BASE=/

# 接口地址（开发走 Vite 代理，见 playground/vite.config.ts）
VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock（登录、商品、活动仍用 Mock）
# 站级问答库已代理到 kb-api：先执行 pnpm dev:kb-api，再 pnpm dev:play
VITE_NITRO_MOCK=true

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 钉钉登录配置
VITE_GLOB_AUTH_DINGDING_CLIENT_ID=应用的clientId
VITE_GLOB_AUTH_DINGDING_CORP_ID=应用的corpId
