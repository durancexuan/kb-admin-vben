# 复制为 .env 后用于 docker compose -f docker-compose.full.yml
# cp .env.production.example .env

POSTGRES_PASSWORD=请改成强密码
KB_API_PORT=8089
ADMIN_PORT=5556

ROBOT_API_KEY=请改成随机长密钥
ACCESS_TOKEN_SECRET=请改成随机长字符串
DEFAULT_STATION_ID=default
MIN_RETRIEVE_SCORE=0.35

# BGE 语义向量（compose 会为 kb-api 注入；本地单独跑 kb-api 时需取消注释）
EMBEDDING_DIM=512
EMBEDDING_API_URL=http://bge-embedding:8090/embed
EMBEDDING_API_FORMAT=simple
EMBEDDING_API_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_API_TIMEOUT_MS=60000
